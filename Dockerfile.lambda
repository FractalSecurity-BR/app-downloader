# Imagem da Lambda do Portal de Aplicativos (API). Mesmo padrão do i-monitor-back /
# i-monitor-dta-back: imagem base AWS Lambda Node 22, handler do serverless-express.
# Build a partir da raiz do repositório:  docker build -f Dockerfile.lambda .

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY api/package.json api/package-lock.json api/
RUN npm --prefix api ci --no-audit --no-fund
COPY tools/manifest-cli/package.json tools/manifest-cli/package-lock.json tools/manifest-cli/
RUN npm --prefix tools/manifest-cli ci --omit=dev --no-audit --no-fund

COPY api/ api/
COPY manifest/ manifest/
COPY tools/ tools/
COPY dev/ dev/
RUN npm --prefix api run build && npm --prefix api prune --omit=dev

# Enquanto o bucket S3 não existe, a Lambda usa STORAGE_DRIVER=local com APKs de
# demonstração gerados pelo próprio manifest-cli (ver dev/seed.sh).
ARG SEED_APK_BYTES=200000
RUN SEED_APK_BYTES=${SEED_APK_BYTES} ./dev/seed.sh


FROM public.ecr.aws/lambda/nodejs:22.2025.01.10.07

WORKDIR ${LAMBDA_TASK_ROOT}

COPY --from=build /app/api/package.json api/package.json
COPY --from=build /app/api/node_modules api/node_modules
COPY --from=build /app/api/dist api/dist
COPY --from=build /app/dev-storage dev-storage
COPY manifest/manifest.schema.json manifest/manifest.schema.json
COPY config/ config/

CMD [ "api/dist/lambda.handler" ]

# ---- obrigatórias ----
# Segredo para assinar a sessão do portal e os links de download (>= 32 caracteres, único por ambiente).
PORTAL_JWT_SECRET=
# URL pública do portal, usada para montar os links de download e o QR Code.
PUBLIC_URL=https://apps.fractal-security.com
# Bucket privado com os APKs e manifestos (credencial AWS via role da instância/task).
STORAGE_DRIVER=s3
S3_BUCKET=
AWS_REGION=sa-east-1

# ---- opcionais (padrões entre parênteses) ----
# PORT=3000
# SESSION_TTL_SECONDS=1800          (sessão do portal: 30 min)
# DOWNLOAD_LINK_TTL_SECONDS=600     (validade do link/QR Code: 10 min)
# PRESIGN_TTL_SECONDS=300           (URL assinada do S3: 5 min)
# MANIFEST_CACHE_SECONDS=30
# LOGIN_RATE_LIMIT_PER_MINUTE=10    (por IP)
# UPSTREAM_TIMEOUT_MS=30000
# TRUST_PROXY=1                     (atrás de load balancer/nginx)
# SYSTEMS_CONFIG_PATH=config/systems.json
